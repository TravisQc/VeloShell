<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloShell.ViewModels"
             xmlns:models="using:VeloShell.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="VeloShell.Views.SftpBrowserView"
             x:DataType="vm:SftpBrowserViewModel">

    <DockPanel Margin="4">
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" Background="#10808080" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <StackPanel Spacing="8">
                <!-- Row 1: Path navigation -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Grid.Column="0" Content="⬆ 上一级" Command="{Binding NavigateUpCommand}" Margin="0,0,6,0" Padding="8,4" />
                    <Button Grid.Column="1" Content="🔄 刷新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="8,4" />
                    <TextBox Grid.Column="2" Text="{Binding PathInput, Mode=TwoWay}"
                             PlaceholderText="输入路径并按回车前往..."
                             VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding GoPathCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="3" Content="前往" Command="{Binding GoPathCommand}" Padding="10,4" />
                </Grid>

                <!-- Row 2: File operations & options -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="➕ 新建文件夹" Command="{Binding NewFolderCommand}" Padding="8,3" FontSize="12" />
                    <Button Content="✏️ 重命名" Command="{Binding RenameSelectedCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Padding="8,3" FontSize="12" />
                    <Button Content="🗑️ 删除" Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Padding="8,3" FontSize="12" />
                    <Border Width="1" Background="#30808080" Margin="4,2" />
                    <CheckBox Content="显示隐藏文件" IsChecked="{Binding ShowHiddenFiles}"
                              Command="{Binding ToggleHiddenFilesCommand}" FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"
                                 IsVisible="{Binding IsLoading}" Margin="8,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Error Notification -->
        <Border DockPanel.Dock="Top" Background="#33FF4444" CornerRadius="4" Padding="8,4" Margin="0,0,0,6"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6666" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- File List Header -->
        <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6" CornerRadius="4,4,0,0">
            <Grid ColumnDefinitions="*,120,110,160">
                <Button Grid.Column="0" Content="名称 ⬍" Command="{Binding SortCommand}" CommandParameter="Name"
                        Background="Transparent" BorderThickness="0" Padding="0" FontWeight="SemiBold" FontSize="12" />
                <Button Grid.Column="1" Content="大小 ⬍" Command="{Binding SortCommand}" CommandParameter="Size"
                        Background="Transparent" BorderThickness="0" Padding="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="权限" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                <Button Grid.Column="3" Content="修改时间 ⬍" Command="{Binding SortCommand}" CommandParameter="ModifiedTime"
                        Background="Transparent" BorderThickness="0" Padding="0" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- File List Content -->
        <Border BorderBrush="#18808080" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DoubleTapped="OnItemDoubleTapped"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SftpEntryItem">
                        <Grid ColumnDefinitions="*,120,110,160" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding IsDirectory, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           IsVisible="False" />
                                <TextBlock Text="📁" IsVisible="{Binding IsDirectory}" FontSize="13" />
                                <TextBlock Text="📄" IsVisible="{Binding !IsDirectory}" FontSize="13" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding HumanSize}" HorizontalAlignment="Right"
                                       Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Permissions}" HorizontalAlignment="Center"
                                       FontFamily="Consolas,Menlo,monospace" Foreground="#808080" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding LastWriteTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                       HorizontalAlignment="Right" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
