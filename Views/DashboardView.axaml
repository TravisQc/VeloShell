<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloShell.ViewModels"
             xmlns:models="using:VeloShell.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="VeloShell.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="4" Padding="12" Margin="4">
        <StackPanel Spacing="10">
            <!-- Header bar: Host summary and controls -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="主机:" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Hostname}" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="内核:" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding KernelVersion}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="运行时间:" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Uptime}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="负载:" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LoadAverage}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding LastUpdated, StringFormat='更新: {0:HH:mm:ss}'}"
                               Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding LastUpdated, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="{Binding PauseResumeButtonText}" Command="{Binding TogglePauseCommand}" FontSize="12" Padding="8,4" />
                    <Button Content="刷新" Command="{Binding RefreshCommand}" FontSize="12" Padding="8,4" />
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Border Background="{DynamicResource StatusErrorSoftBrush}" CornerRadius="4" Padding="8,4"
                    IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding LastError, StringFormat='采集异常: {0}'}" Classes="caption" Foreground="{DynamicResource StatusErrorBrush}" />
            </Border>

            <!-- 4 Metrics Cards: CPU, Memory, Swap, Network -->
            <UniformGrid Columns="4" Rows="1">
                <!-- CPU Card -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="CPU" Classes="body" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuCoresText}" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <ProgressBar Value="{Binding CpuUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:F1}%'}" Classes="subheading" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="使用率" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory Card -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="物理内存" Classes="body" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <ProgressBar Value="{Binding MemoryUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding MemoryUsagePercent, StringFormat='{}{0:F1}%'}" Classes="subheading" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="占用率" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Swap Card -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Swap" Classes="body" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SwapText}" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <ProgressBar Value="{Binding SwapUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding SwapUsagePercent, StringFormat='{}{0:F1}%'}" Classes="subheading" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="占用率" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Network Card -->
                <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="实时网速" Classes="body" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalNetworkText}" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                            <mi:MaterialIcon Kind="ArrowDownBold" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding DownloadRateText}" Classes="body" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <mi:MaterialIcon Kind="ArrowUpBold" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusHealthyBrush}" />
                            <TextBlock Text="{Binding UploadRateText}" Classes="body" FontWeight="SemiBold" Foreground="{DynamicResource StatusHealthyBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="实时吞吐速率" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Disks Partitions -->
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskPartitionMetrics">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4" Padding="8,4" MinWidth="160">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding MountedOn, StringFormat='挂载: {0}'}" Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsagePercent, StringFormat='{}{0:F1}%'}" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                                <ProgressBar Value="{Binding UsagePercent}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
