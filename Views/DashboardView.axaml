<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloShell.ViewModels"
             xmlns:models="using:VeloShell.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="300"
             x:Class="VeloShell.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Border Background="#10808080" CornerRadius="4" Padding="12" Margin="4">
        <StackPanel Spacing="10">
            <!-- Header bar: Host summary and controls -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="主机:" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="内核:" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding KernelVersion}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="运行时间:" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Uptime}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="负载:" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LoadAverage}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding LastUpdated, StringFormat='更新: {0:HH:mm:ss}'}"
                               Foreground="#808080" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding LastUpdated, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="{Binding PauseResumeButtonText}" Command="{Binding TogglePauseCommand}" FontSize="12" Padding="8,4" />
                    <Button Content="刷新" Command="{Binding RefreshCommand}" FontSize="12" Padding="8,4" />
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Border Background="#33FF4444" CornerRadius="4" Padding="8,4"
                    IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding LastError, StringFormat='采集异常: {0}'}" Foreground="#FF6666" FontSize="12" />
            </Border>

            <!-- 4 Metrics Cards: CPU, Memory, Swap, Network -->
            <UniformGrid Columns="4" Rows="1">
                <!-- CPU Card -->
                <Border Background="#18808080" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuCoresText}" Foreground="#808080" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding CpuUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="使用率" Foreground="#808080" FontSize="11" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory Card -->
                <Border Background="#18808080" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="物理内存" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Foreground="#808080" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding MemoryUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding MemoryUsagePercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="占用率" Foreground="#808080" FontSize="11" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Swap Card -->
                <Border Background="#18808080" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Swap" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding SwapText}" Foreground="#808080" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding SwapUsagePercent}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding SwapUsagePercent, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="占用率" Foreground="#808080" FontSize="11" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Network Card -->
                <Border Background="#18808080" CornerRadius="4" Padding="10" Margin="4">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="实时网速" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalNetworkText}" Foreground="#808080" FontSize="10" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2">
                            <TextBlock Text="{Binding DownloadRateText, StringFormat='↓ {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#33AAFF" />
                            <TextBlock Text="{Binding UploadRateText, StringFormat='↑ {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#33DD66" />
                        </StackPanel>
                        <TextBlock Text="实时吞吐速率" Foreground="#808080" FontSize="11" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Disks Partitions -->
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskPartitionMetrics">
                        <Border Background="#12808080" CornerRadius="4" Padding="8,4" MinWidth="160">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding MountedOn, StringFormat='挂载: {0}'}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsagePercent, StringFormat='{}{0:F1}%'}" FontSize="11" Foreground="#808080" />
                                </Grid>
                                <ProgressBar Value="{Binding UsagePercent}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
