<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloShell.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="VeloShell.Views.ConnectionDetailTabView"
             x:DataType="vm:ConnectionDetailTabViewModel">

    <Border Padding="24" Background="Transparent">
        <StackPanel Spacing="16"
                    IsVisible="{Binding Main.SelectedNode.Connection, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Main.SelectedNode.Connection.Label}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="🚀 发起连接"
                        Command="{Binding Main.ConnectSelectedCommand}"
                        FontWeight="Bold" Padding="14,6" />
            </Grid>

            <Border Height="1" Background="#20808080" />

            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="主机" Foreground="#90808080" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Main.SelectedNode.Connection.Host}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" Foreground="#90808080" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Main.SelectedNode.Connection.Port}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="用户名" Foreground="#90808080" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Main.SelectedNode.Connection.Username}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="认证方式" Foreground="#90808080" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Main.SelectedNode.Connection.AuthMethod}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="备注" Foreground="#90808080" VerticalAlignment="Top" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Main.SelectedNode.Connection.Notes}" TextWrapping="Wrap" />
            </Grid>

            <Border Background="#10808080" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="💡 提示" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="• 双击左侧连接树中的连接，或点击右上角「发起连接」，将建立会话并在新标签页中打开「系统信息仪表盘」和「SFTP 文件浏览器」。"
                               Foreground="#808080" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="• 凭据已通过 Argon2id + AES-256-GCM 安全加密存储，不在此处明文展示。"
                               Foreground="#808080" FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
