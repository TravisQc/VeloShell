<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeloShell.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="VeloShell.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="650"
        Title="VeloShell">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="6">
            <Button Content="🚀 连接" Command="{Binding ConnectSelectedCommand}"
                    IsEnabled="{Binding SelectedNode.Connection, Converter={x:Static ObjectConverters.IsNotNull}}"
                    FontWeight="SemiBold" />
            <Border Width="1" Background="#40808080" Margin="2,2" />
            <Button Content="新建连接" Command="{Binding NewConnectionCommand}" />
            <Button Content="新建文件夹" Command="{Binding NewFolderCommand}" />
            <Button Content="编辑" Command="{Binding EditConnectionCommand}" />
            <Button Content="移动" Command="{Binding MoveSelectedCommand}" />
            <Button Content="重命名" Command="{Binding RenameFolderCommand}" />
            <Button Content="删除" Command="{Binding DeleteCommand}" />
            <Border Width="1" Background="#40808080" Margin="4,2" />
            <Button Content="更改主密码" Command="{Binding ChangeMasterPasswordCommand}" />
            <Button Content="锁定" Command="{Binding LockCommand}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="10,5" Background="#18808080">
            <TextBlock Text="{Binding StatusText}" FontSize="12" />
        </Border>

        <Grid ColumnDefinitions="280,4,*">
            <TreeView x:Name="ConnectionTree" Grid.Column="0"
                      DragDrop.AllowDrop="True"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode}"
                      DoubleTapped="OnTreeDoubleTapped">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,3">
                            <TextBlock Text="📁" IsVisible="{Binding IsFolder}" FontSize="12" />
                            <TextBlock Text="🖥️" IsVisible="{Binding !IsFolder}" FontSize="12" />
                            <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="#20808080" ResizeDirection="Columns" />

            <TabControl Grid.Column="2"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ViewModelBase">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                            <Button Content="✕"
                                    Command="{Binding ((vm:MainViewModel)DataContext).CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding CanClose}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="2" Margin="4,0,0,0" FontSize="10" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
