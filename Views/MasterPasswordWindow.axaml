<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeloShell.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="VeloShell.Views.MasterPasswordWindow"
        x:DataType="vm:MasterPasswordViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />

        <StackPanel IsVisible="{Binding ShowCurrent}" Spacing="4">
            <TextBlock Text="当前主密码" />
            <TextBox Text="{Binding CurrentPassword}" PasswordChar="●" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="主密码" />
            <TextBox Text="{Binding Password}" PasswordChar="●" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowConfirm}" Spacing="4">
            <TextBlock Text="确认主密码" />
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" />
        </StackPanel>

        <TextBlock IsVisible="{Binding ShowResetHint}"
                   TextWrapping="Wrap" Foreground="#B0000000" FontSize="12"
                   Text="主密码无法找回。若已遗忘,只能重置凭据库(将清空全部已存凭据)。" />

        <TextBlock IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding Error}" Foreground="#C00000" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="重置凭据库" Command="{Binding ResetVaultCommand}"
                    IsVisible="{Binding ShowResetHint}" Foreground="#C00000" />
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Content="确定" Command="{Binding SubmitCommand}" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
