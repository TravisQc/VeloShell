<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeloShell.ViewModels"
             xmlns:views="using:VeloShell.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="VeloShell.Views.SessionView"
             x:DataType="vm:SessionViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Session Status Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}" Padding="12,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="subheading" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Connection.Host, StringFormat='({0})'}" Classes="caption"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <!-- Status Badge -->
                    <Border CornerRadius="3" Padding="6,2" Background="{DynamicResource SurfaceOverlayBrush}">
                        <TextBlock Text="{Binding StatusText}" Classes="caption"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="重新连接" Command="{Binding ReconnectCommand}"
                            IsVisible="{Binding IsDisconnectedOrError}" Padding="10,4" />
                    <Button Content="断开连接" Command="{Binding DisconnectCommand}"
                            IsVisible="{Binding IsConnected}" Padding="10,4" />
                    <Button Content="关闭会话" Command="{Binding CloseCommand}" Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: TabControl with Terminal, SFTP, and Dashboard -->
        <TabControl Grid.Row="1" TabStripPlacement="Top">
            <TabItem Header="交互式终端">
                <views:TerminalView DataContext="{Binding Terminal}" />
            </TabItem>
            <TabItem Header="SFTP 文件">
                <views:SftpBrowserView DataContext="{Binding Sftp}" />
            </TabItem>
            <TabItem Header="性能监控">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
